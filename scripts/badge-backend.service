[Unit]
Description=Badge Auth Platform Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/repo/Sel_Badge/backend
Environment=BADGE_JWT_SECRET=BadgeAuthSuperSecureJWTSecretKeyWithMinimum256BitsLengthForProduction2026!
Environment=BADGE_CRYPTO_MASTER_KEY=BadgeAuthPlatformSecureMasterKeyAES256@2026!!
Environment=BADGE_CORS_ORIGINS=http://39.97.50.218:8080,http://39.97.50.218:8180,http://39.97.50.218:8280,http://39.97.50.218,http://39.97.50.218:100,http://39.97.50.218:105,http://39.97.50.218:106,http://localhost:8080,http://localhost:8180,http://localhost:8280,http://localhost:5173,http://127.0.0.1:5173
ExecStart=/usr/bin/java -Xms128m -Xmx256m -XX:+UseG1GC -jar /srv/repo/Sel_Badge/backend/target/badge-auth-platform-1.0.0.jar --server.port=8088 --server.address=127.0.0.1
Restart=always
RestartSec=5
StandardOutput=append:/var/log/badge-backend.log
StandardError=append:/var/log/badge-backend.err.log

[Install]
WantedBy=multi-user.target
