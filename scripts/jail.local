[DEFAULT]
bantime = 1d
findtime = 10m
maxretry = 5

[sshd]
enabled = true
port = ssh
maxretry = 3
findtime = 10m
bantime = 24h

[nginx-limit-req]
enabled = true
port = http,https,8080,8180,8280,100,105,106
filter = nginx-limit-req
logpath = /var/log/nginx/error.log
findtime = 10m
maxretry = 10
bantime = 2h

[nginx-botsearch]
enabled = true
port = http,https,8080,8180,8280,100,105,106
filter = nginx-botsearch
logpath = /var/log/nginx/access.log
maxretry = 2
bantime = 2d
